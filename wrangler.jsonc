{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-file-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-06",
  "routes": [
    {
      "pattern": "worker-file.ihurtadov.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "r2_buckets": [
    {
      "binding": "BUCKET_IHV",
      "bucket_name": "ihv"
    },
    {
      "binding": "BUCKET_SCI",
      "bucket_name": "sci"
    },
    {
      "binding": "BUCKET_SISCI",
      "bucket_name": "sisci"
    },
    {
      "binding": "BUCKET_CALIDAD",
      "bucket_name": "calidad"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB_LOG",
      "database_name": "worker-file-db",
      "database_id": "7bcebb7e-f660-4ff6-975c-25992b15d925"
    }
  ]
}